[access]
mode = "streamlit_private"

[app]
enable_advisor_view = false

[alpaca]
# Optional price-only market data. Leave blank to keep manual/uploaded prices.
api_key_id = ""
api_secret_key = ""
data_feed = "iex"
data_base_url = "https://data.alpaca.markets"

# Root-level Streamlit secrets named APCA_API_KEY_ID and
# APCA_API_SECRET_KEY are also accepted.
